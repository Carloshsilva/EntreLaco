# Configuração da EntreLaço na VPS. Copie para .env (cp .env.example .env) e troque os valores.
# O .env tem segredos: nunca vai para o Git (já está no .gitignore) e só o administrador lê
# (chmod 600 .env). Nada aqui é segredo de verdade: são exemplos para trocar.

# ---------------------------------------------------------------- endereço do site

# Domínio que o Caddy atende, com o HTTPS automático. O DNS dele precisa apontar para a VPS.
DOMINIO=entrelaco.exemplo.org

# Os mesmos domínio(s) para o Django, separados por vírgula.
DJANGO_ALLOWED_HOSTS=entrelaco.exemplo.org
# Endereço completo, com https://, para os formulários serem aceitos.
DJANGO_CSRF_TRUSTED_ORIGINS=https://entrelaco.exemplo.org

# ---------------------------------------------------------------- segredos do Django

# Chave secreta do Django: longa, aleatória e diferente em cada instalação. Para gerar uma:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-gerada-com-o-comando-acima

# Fica desligado na VPS. Ligar (1) mostra detalhes de erro na tela: só no computador de quem programa.
DJANGO_DEBUG=0

# ---------------------------------------------------------------- banco de dados

POSTGRES_DB=entrelaco
POSTGRES_USER=entrelaco
# Senha do banco, só com letras e números. Para gerar uma:  openssl rand -hex 24
# Defina antes de subir pela primeira vez: depois disso, o banco já foi criado com ela.
POSTGRES_PASSWORD=troque-por-uma-senha-gerada

# Endereço do banco para o Django. No Docker, o docker-compose.yml monta este endereço sozinho com as
# variáveis POSTGRES_* acima. Preencha só se rodar a EntreLaço fora do Docker:
# DATABASE_URL=postgres://entrelaco:SENHA@localhost:5432/entrelaco

# ---------------------------------------------------------------- dados e cópias de segurança

# Faixa "Ambiente de teste" em todas as telas e permissão para carregar os dados fictícios.
# Na primeira versão só se usa dado inventado: deixe 1.
ENTRELACO_AMBIENTE_DE_TESTE=1

# Pasta do servidor (fora do Docker) onde deploy/backup.sh guarda as cópias de 30 dias.
PASTA_COPIAS=/var/backups/entrelaco

# Pasta das fotos e documentos dentro do contêiner. O docker-compose.yml já define; só para rodar fora do Docker:
# ENTRELACO_PASTA_PRIVADA=/dados/privado

# ---------------------------------------------------------------- opcionais

# Verificação em duas etapas para quem configura o serviço e para o administrador (SEG-07). Deixe 1.
# ENTRELACO_EXIGIR_DUAS_ETAPAS=1
# Tempo sem uso até a sessão expirar, em segundos (padrão: 1800, ou seja, 30 minutos).
# ENTRELACO_SESSAO_SEGUNDOS=1800
# Tentativas erradas de senha antes do bloqueio, e por quantos minutos bloqueia.
# ENTRELACO_LOGIN_TENTATIVAS=5
# ENTRELACO_LOGIN_BLOQUEIO_MINUTOS=15
# Quanto detalhe vai para os registros (docker compose logs web): DEBUG, INFO, WARNING ou ERROR.
# DJANGO_LOG_LEVEL=INFO
# Processos e tempo máximo de cada tela no Gunicorn.
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
# HTTPS: o Django manda quem chega por http para https e avisa o navegador para usar só https.
# O Caddy já faz as duas coisas (o aviso, por 30 dias); mude só se souber o motivo.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=2592000

# ---------------------------------------------------------------- e-mail (opcional)

# Sem estas linhas, os e-mails (como o link para definir a senha) só aparecem nos registros
# (docker compose logs web). Para enviar de verdade, preencha com os dados do seu provedor de e-mail:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.exemplo.org
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_EMAIL_HOST_USER=nao-responda@exemplo.org
# DJANGO_EMAIL_HOST_PASSWORD=troque-pela-senha-do-e-mail
# DJANGO_DEFAULT_FROM_EMAIL=EntreLaço <nao-responda@exemplo.org>
